# Database
DB_NAME=flollylist
DB_USER=flollylist
DB_VOLUME_NAME=flollylist_db_data

# Production only (the password lives in the secrets/ folder, see README.md)
DB_MEMORY_LIMIT=1g

# Development only. Commented out so they never reach a production .env:
# docker-compose.dev.yml has a default value for each of them.
# DB_PASSWORD=postgres
# DB_PORT=5433
# HOST_UID=1000
# HOST_GID=1000
